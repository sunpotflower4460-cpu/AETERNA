{
  "name": "aeterna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.ts'",
    "lint:js": "eslint 'src/**/*.js'",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "compare:longrun": "tsx src/comparison/runLongRunComparisonCli.ts",
    "check:release": "tsx scripts/run-release-checks.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
